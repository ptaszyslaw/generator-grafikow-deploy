{
  "name": "Generator grafików",
  "short_name": "Grafiki",
  "description": "Układanie miesięcznych grafików pracy strażników. Grafik zostaje w pliku na Twoim komputerze.",
  "lang": "pl",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f4f6f5",
  "theme_color": "#1f5f46",
  "icons": [
    { "src": "ikona-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "ikona-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "ikona-maskowalna-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".json"] }, "icons": [{ "src": "ikona-192.png", "sizes": "192x192", "type": "image/png" }], "launch_type": "single-client" }
  ]
}
